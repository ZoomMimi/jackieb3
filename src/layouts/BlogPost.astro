---
import Layout from './Layout.astro';
import PostMiniMap from '../components/PostMiniMap.astro';
import NeboMap from '../components/NeboMap.astro';
import VoyageStats from '../components/VoyageStats.astro';
import Lightbox from '../components/Lightbox.astro';
import VideoFacade from '../components/VideoFacade.astro';
import DateNav from '../components/DateNav.astro';
import dailyRoutes from '../data/daily-routes.json';
import neboMaps from '../data/nebo-maps.json';
import neboDayStats from '../data/nebo-day-stats.json';

interface NavLink {
  id: string;
  title: string;
}

interface DateEntry {
  id: string;
  date: Date;
  title: string;
}

interface Props {
  title: string;
  date: Date;
  location: string;
  excerpt: string;
  voyage?: string;
  migrated?: boolean;
  lat?: number;
  lon?: number;
  coverPhoto?: string;
  anchorage?: string;
  marina?: string;
  miles?: number;
  hours?: number;
  prev?: NavLink | null;
  next?: NavLink | null;
  allDates?: DateEntry[];
  currentId?: string;
}

const { title, date, location, excerpt, prev, next, lat, lon, miles, hours, allDates, currentId } = Astro.props;

const dateKey = date.toISOString().slice(0, 10);
const routeData = (dailyRoutes as Record<string, { start: [number,number]|null; end: [number,number]|null; track: [number,number][]; photos: [number,number,number][] }>)[dateKey];
const startLat = routeData?.start?.[0];
const startLon = routeData?.start?.[1];
const track    = routeData?.track   ?? [];
const photos   = routeData?.photos  ?? [];
const neboMapUrl = (neboMaps as Record<string, string>)[dateKey];
const dayStats = (neboDayStats as Record<string, { maxKnots?: number; avgKnots?: number; weather?: string }>)[dateKey];

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Layout title={title} description={excerpt}>
  <div class="post-with-nav max-w-[920px] mx-auto px-6 py-12">
    {allDates && currentId && (
      <div class="date-nav-wrap">
        <DateNav dates={allDates} currentId={currentId} />
      </div>
    )}
  <div class="max-w-[720px] mx-auto post-main-col">
    <!-- Post navigation (top) -->
    <nav class="post-nav post-nav--top">
      <div class="post-nav-prev">
        {prev && (
          <a href={`/blog/${prev.id}`}>
            <span class="post-nav-arrow">←</span>
            <span class="post-nav-label">Previous</span>
            <span class="post-nav-title">{prev.title}</span>
          </a>
        )}
      </div>
      <div class="post-nav-next">
        {next && (
          <a href={`/blog/${next.id}`}>
            <span class="post-nav-title">{next.title}</span>
            <span class="post-nav-label">Next</span>
            <span class="post-nav-arrow">→</span>
          </a>
        )}
      </div>
    </nav>

    <article>
      <!-- Post title -->
      <h1 class="font-inter font-bold text-[28px] text-ink leading-[1.2] mb-4">
        {title}
      </h1>

      <!-- Meta row: date + location -->
      <div class="flex gap-4 items-center mb-8">
        <time
          datetime={date.toISOString().slice(0, 10)}
          class="font-inter text-[14px] text-muted"
        >
          {formattedDate}
        </time>
        {location && (
          <span class="font-inter text-[14px] text-muted">&mdash; {location}</span>
        )}
      </div>

      <!-- Trip stats moved here from the bottom of the post, and enriched
           with max/avg speed + weather from Nebo's own log when available. -->
      <VoyageStats
        miles={miles}
        hours={hours}
        maxKnots={dayStats?.maxKnots}
        avgKnots={dayStats?.avgKnots}
        weather={dayStats?.weather}
      />

      <!-- Original Nebo trip map, when this day has one. Replaces the
           GPS-derived PostMiniMap entirely for now — scripts/14-audit-route-accuracy.mjs
           found 137 of 171 Nebo-covered days have a materially wrong track,
           and there's no reliable fix without fresh GPX exports from the
           Nebo app per day (deferred). PostMiniMap still renders on days
           with no Nebo map, since it's the only route data available there. -->
      {neboMapUrl ? (
        <NeboMap src={neboMapUrl} date={dateKey} />
      ) : (
        lat !== undefined && lon !== undefined && (
          <PostMiniMap lat={lat} lon={lon} location={location} startLat={startLat} startLon={startLon} track={track} photos={photos} />
        )
      )}

      <!-- Post body: MDX content -->
      <div class="post-body">
        <slot />
      </div>

      <Lightbox />
      <VideoFacade />
    </article>

    <!-- Post navigation -->
    <nav class="post-nav">
      <div class="post-nav-prev">
        {prev && (
          <a href={`/blog/${prev.id}`}>
            <span class="post-nav-arrow">←</span>
            <span class="post-nav-label">Previous</span>
            <span class="post-nav-title">{prev.title}</span>
          </a>
        )}
      </div>
      <div class="post-nav-next">
        {next && (
          <a href={`/blog/${next.id}`}>
            <span class="post-nav-title">{next.title}</span>
            <span class="post-nav-label">Next</span>
            <span class="post-nav-arrow">→</span>
          </a>
        )}
      </div>
    </nav>
  </div>
  </div>
</Layout>

<style>
  .post-with-nav {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .post-main-col {
    flex: 1 1 auto;
    min-width: 0;
  }
  .date-nav-wrap {
    display: none;
  }
  @media (min-width: 1024px) {
    .date-nav-wrap {
      display: block;
    }
  }

  /* Scope prose styles to post body so they don't affect nav */
  .post-body {
    font-family: var(--font-lora), Georgia, serif;
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-ink);
  }

  .post-body h2 {
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink);
    margin-top: 2em;
    margin-bottom: 0.75em;
  }

  .post-body h3 {
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-ink);
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .post-body p {
    margin-bottom: 1.5em;
  }

  .post-body a {
    color: var(--color-brass);
    text-decoration: underline;
  }

  .post-body a:hover {
    color: #991515;
  }

  .post-body ul,
  .post-body ol {
    padding-left: 1.5em;
    margin-bottom: 1.5em;
  }

  .post-body li {
    margin-bottom: 0.5em;
  }

  .post-body blockquote {
    border-left: 3px solid var(--color-brass);
    padding-left: 1em;
    margin-left: 0;
    font-style: italic;
    color: var(--color-muted);
  }

  /* Closing Bible verse — set apart from regular body text as its own card.
     :global() is required here: this blockquote is injected into the MDX
     content by the rehype-bible-verse plugin, not written in this file's
     own template, so Astro's scoped-style attribute is never added to it —
     an unscoped selector is the only way to reach it. */
  .post-body :global(blockquote.verse-frame) {
    margin: 2.5em 0 1.5em;
    padding: 1.5em 1.75em;
    border: none;
    border-left: 4px solid var(--color-navy);
    border-radius: 6px;
    background: rgba(26, 46, 74, 0.05);
  }

  .post-body :global(blockquote.verse-frame p) {
    font-style: italic;
    font-size: 20px;
    line-height: 1.6;
    color: var(--color-ink);
    margin-bottom: 0.75em;
  }

  .post-body :global(blockquote.verse-frame footer) {
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .post-body :global(blockquote.verse-frame footer cite) {
    font-style: normal;
  }

  .post-body :global(blockquote.verse-frame footer a) {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted var(--color-navy);
  }

  /* Bare video URLs, auto-embedded by the rehype-video-embed plugin as a
     click-to-play facade — same :global() reasoning as verse-frame above.
     VideoFacade.astro swaps .video-embed__play for a real <iframe> on
     click; that iframe reuses this same padding-bottom aspect-ratio box. */
  .post-body :global(.video-embed) {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    margin: 1.5rem 0;
    border-radius: 4px;
    background: var(--color-navy);
  }

  .post-body :global(.video-embed iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    border: none;
  }

  .post-body :global(.video-embed__play) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: none;
  }

  .post-body :global(.video-embed__poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-body :global(.video-embed__icon) {
    position: relative;
    z-index: 1;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
    transition: transform 0.15s ease;
  }

  .post-body :global(.video-embed__play:hover .video-embed__icon) {
    transform: scale(1.08);
  }

  .post-body :global(.video-embed__icon svg) {
    width: 24px;
    height: 24px;
    fill: var(--color-navy);
    margin-left: 3px;
  }

  .post-body hr {
    border: none;
    border-top: 1px solid var(--color-navy);
    margin: 2em 0;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e7eb;
  }

  .post-nav--top {
    margin-top: 0;
    margin-bottom: 2rem;
    padding-top: 0;
    padding-bottom: 1.5rem;
    border-top: none;
    border-bottom: 1px solid #e5e7eb;
  }

  .post-nav-prev,
  .post-nav-next {
    flex: 1;
    min-width: 0;
  }

  .post-nav-next {
    text-align: right;
  }

  .post-nav a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    color: var(--color-ink);
  }

  .post-nav a:hover .post-nav-title {
    color: var(--color-brass);
  }

  .post-nav-arrow {
    font-size: 1.25rem;
    color: var(--color-navy);
  }

  .post-nav-label {
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .post-nav-title {
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
