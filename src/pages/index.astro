---
import Layout from '../layouts/Layout.astro';

const choices = [
  {
    title: 'Our Blog',
    description: 'The Great Loop voyage, documented stop by stop.',
    href: '/voyages/great-loop/',
    external: false,
  },
  {
    title: "Jackie's Story",
    description: 'Read the story, shared on Google Drive.',
    href: 'https://drive.google.com/file/d/1BOrSJeyLRh42NrEktrqXwwc2Fk9zdbdy/view?usp=drive_link',
    external: true,
  },
  {
    title: "Jackie's Song",
    description: 'Listen to the song, shared on Google Drive.',
    href: 'https://drive.google.com/file/d/1yG-LvkAXO2rJJXsHee1RDI52JWPCnWcD/view?usp=drive_link',
    external: true,
  },
];
---

<Layout title="Jackie B III Going Loopy" description="Welcome to the Jackie B III site — the Great Loop voyage blog, Jackie's Story, and Jackie's Song.">
  <section class="w-full bg-navy py-16 md:py-24 text-center" style="padding-top: 64px; padding-bottom: 64px;">
    <div class="max-w-[720px] mx-auto px-6">
      <h1 class="font-inter font-bold text-[36px] text-offwhite leading-[1.2] mb-4">
        Welcome Aboard
      </h1>
      <p class="font-inter text-[18px] text-muted mb-12">
        Jackie B III on the Great Loop, 2022&ndash;2024
      </p>
    </div>

    <div class="max-w-[960px] mx-auto px-6 mb-12">
      <picture>
        <source srcset="/website-card-optimized.webp" type="image/webp" />
        <img
          src="/website-card.png"
          width="2752"
          height="1796"
          alt="Jackie B III contact card: Mike and Barbara aboard, holding the AGLCA burgee, with contact info, the Anchored in Truth (Hebrews 6:13-20) mark, and a QR code linking to Jackie's Story, Jackie's Song, and this blog."
          class="w-full h-auto rounded-2xl shadow-2xl"
          loading="eager"
        />
      </picture>
    </div>

    <div class="max-w-[720px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {choices.map((choice) => (
          <a
            href={choice.href}
            target={choice.external ? '_blank' : undefined}
            rel={choice.external ? 'noopener noreferrer' : undefined}
            class="block bg-[#233d61] rounded-lg px-6 py-8 no-underline hover:bg-[#2c4a75] focus-visible:ring-2 focus-visible:ring-brass focus-visible:outline-none transition-colors"
          >
            <h2 class="font-inter font-bold text-[20px] text-brass mb-2">
              {choice.title}
            </h2>
            <p class="font-inter text-[14px] text-muted">
              {choice.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
