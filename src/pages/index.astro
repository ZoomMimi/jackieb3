---
import Layout from '../layouts/Layout.astro';

const choices = [
  {
    title: "Jackie's Story",
    description: 'Read the story, shared on Google Drive.',
    href: 'https://drive.google.com/file/d/1BOrSJeyLRh42NrEktrqXwwc2Fk9zdbdy/view?usp=drive_link',
    external: true,
  },
  {
    title: "Jackie's Song",
    description: 'Listen to the song, shared on Google Drive.',
    href: 'https://drive.google.com/file/d/1yG-LvkAXO2rJJXsHee1RDI52JWPCnWcD/view?usp=drive_link',
    external: true,
  },
  {
    title: 'Our Blog',
    description: 'The Great Loop voyage, documented stop by stop.',
    href: 'https://jackiebiiigoingloopy.blogspot.com/2022/04/the-adventure-begins.html',
    external: true,
  },
  {
    title: 'The Anchor We Cannot See',
    description: 'A reflection on Hebrews 6:19.',
    href: '/the-anchor-we-cannot-see.pdf',
    external: true,
  },
  {
    title: 'Strength As One',
    description: "Life Lessons from West Point's Class of 1981. Jackie's story is included in this book, available on Amazon.",
    href: 'https://www.amazon.com/dp/B0HBS1SCM4',
    external: true,
    wide: true,
  },
];
---

<Layout title="Jackie B III Going Loopy" description="Welcome to the Jackie B III site — the Great Loop voyage blog, Jackie's Story, and Jackie's Song.">
  <section class="w-full bg-navy py-16 md:py-24 text-center" style="padding-top: 64px; padding-bottom: 64px;">
    <div class="max-w-[720px] mx-auto px-6">
      <h1 class="font-inter font-bold text-[36px] text-offwhite leading-[1.2] mb-4">
        The Jackie B III
      </h1>
      <p class="font-inter text-[18px] text-muted mb-12">
        Welcome Aboard
      </p>
    </div>

    <div class="max-w-[1200px] mx-auto px-6 mb-12 grid grid-cols-1 md:grid-cols-2 gap-6">
      <picture>
        <source srcset="/boat-card-optimized.webp" type="image/webp" />
        <img
          src="/boat-card.png"
          width="2000"
          height="1305"
          alt="The Jackie B III, Mike and Barbara Bruhn's 2006 455 Cruisers Yacht, underway with the two of them waving from the cockpit."
          class="w-full h-auto rounded-2xl shadow-2xl"
          loading="eager"
        />
      </picture>
      <picture>
        <source srcset="/website-card-optimized.webp" type="image/webp" />
        <img
          src="/website-card.png"
          width="2000"
          height="1305"
          alt="Jackie B III contact card: Mike and Barbara aboard, holding the AGLCA burgee, with contact info, the Anchored to Truth (Hebrews 6:13-20) mark, and a QR code linking to Jackie's Story, Jackie's Song, and this blog."
          class="w-full h-auto rounded-2xl shadow-2xl"
          loading="eager"
        />
      </picture>
    </div>

    <div class="max-w-[720px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {choices.map((choice) => (
          <a
            href={choice.href}
            target={choice.external ? '_blank' : undefined}
            rel={choice.external ? 'noopener noreferrer' : undefined}
            class:list={[
              'block bg-[#233d61] rounded-lg px-6 py-8 no-underline hover:bg-[#2c4a75] focus-visible:ring-2 focus-visible:ring-brass focus-visible:outline-none transition-colors',
              choice.wide && 'md:col-span-2',
            ]}
          >
            <h2 class="font-inter font-bold text-[20px] text-brass mb-2">
              {choice.title}
            </h2>
            <p class="font-inter text-[14px] text-muted">
              {choice.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
