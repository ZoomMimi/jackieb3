---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  // Local-preview-only escape hatch: PREVIEW_DRAFTS=1 (set via `npm run dev:drafts`) makes
  // draft posts visible. A production build must NEVER set this env var.
  const posts = await getCollection(
    'blog',
    ({ data }) => !data.draft || import.meta.env.PREVIEW_DRAFTS === '1',
  );
  const sorted = posts.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  const allDates = sorted.map((p) => ({ id: p.id, date: p.data.date, title: p.data.title }));
  return sorted.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      prev: i > 0 ? { id: sorted[i - 1].id, title: sorted[i - 1].data.title } : null,
      next: i < sorted.length - 1 ? { id: sorted[i + 1].id, title: sorted[i + 1].data.title } : null,
      allDates,
    },
  }));
}

const { post, prev, next, allDates } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} prev={prev} next={next} allDates={allDates} currentId={post.id}>
  <Content />
</BlogPost>
