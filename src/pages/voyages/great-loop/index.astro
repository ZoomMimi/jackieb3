---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import LoopSummary from '../../../components/LoopSummary.astro';
import Lightbox from '../../../components/Lightbox.astro';

// Local-preview-only escape hatch: PREVIEW_DRAFTS=1 (set via `npm run dev:drafts`) makes
// draft posts visible. A production build must NEVER set this env var.
const posts = await getCollection(
  'blog',
  ({ data }) => data.voyage === 'great-loop' && (!data.draft || import.meta.env.PREVIEW_DRAFTS === '1'),
);

const sortedPosts = posts.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<Layout
  title="Great Loop — Jackie B III Going Loopy"
  description="The full Great Loop voyage aboard Jackie B III, 22 April 2022 to 17 May 2024. 6,273.4 nautical miles documented stop by stop."
>
  <div class="max-w-[720px] mx-auto px-6 py-12">
    <!-- Page heading -->
    <h1 class="font-inter font-bold text-[28px] text-ink leading-[1.2] mb-6">Great Loop</h1>

    <LoopSummary />

    <figure class="completion-photo">
      <img
        class="zoomable-img"
        src="/loop-completion.jpg"
        alt="Mike and Barbara toasting with champagne aboard Jackie B III, holding the AGLCA burgee, at the dock in New Bern NC after completing the Great Loop"
        loading="lazy"
        decoding="async"
      />
      <figcaption>We made it &mdash; New Bern, NC</figcaption>
    </figure>

    {sortedPosts.length === 0 ? (
      <div class="text-center py-8">
        <p class="font-lora text-[18px] text-muted mb-2">No posts yet. The voyage begins soon.</p>
        <p class="font-inter text-[14px] text-muted">This section will fill in as posts are published. Check back soon.</p>
      </div>
    ) : (
      <ul class="list-none p-0 m-0">
        {sortedPosts.map((post, i) => (
          <li>
            {i > 0 && <hr class="border-0 border-t border-navy my-6" />}
            <article class="py-2">
              <time
                datetime={post.data.date.toISOString().slice(0, 10)}
                class="font-inter text-[14px] text-muted block mb-1"
              >
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
              <h2 class="font-inter font-bold text-[20px] leading-[1.3] mb-2 mt-0">
                <a
                  href={`/blog/${post.id}`}
                  class="text-brass no-underline hover:underline hover:text-[#991515] focus-visible:ring-2 focus-visible:ring-brass focus-visible:outline-none"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="font-lora text-[18px] text-ink leading-[1.7] mb-2">
                {post.data.excerpt}
              </p>
              <p class="font-inter text-[14px] text-muted">
                {post.data.location}
              </p>
            </article>
          </li>
        ))}
      </ul>
    )}
  </div>

  <Lightbox />
</Layout>

<style>
  .completion-photo {
    margin: 0 0 2.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
  }
  .completion-photo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .completion-photo figcaption {
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 12px;
    color: var(--color-muted);
    text-align: center;
    padding: 0.5rem 0.75rem;
    background: var(--color-offwhite);
  }
</style>
