---
// LoopSummary.astro
// Whole-voyage route map: Nebo's own full-circle route, 22 Apr 2022-17 May
// 2024. The map image itself already shows the trip stats (234 boat
// movements, 679 hours underway, 6,273.4nm, 9.2 avg kn, 30.0 max kn) baked
// in, so they're not duplicated as separate text here — see about.astro for
// the prose version of these numbers.
---

<div class="loop-summary">
	<figure class="loop-summary__map">
		<img
			class="zoomable-img"
			src="/loop-summary-map.jpg"
			alt="Map of the complete Great Loop route sailed by Jackie B III, a closed circuit from New Bern NC up the East Coast, through the Great Lakes and Canada, down the Mississippi and Tennessee-Tombigbee waterways, around Florida, and back to New Bern"
			loading="lazy"
			decoding="async"
		/>
		<figcaption>The full route &mdash; click to zoom</figcaption>
	</figure>
</div>

<style>
	.loop-summary {
		margin-bottom: 2.5rem;
	}
	.loop-summary__map {
		margin: 0;
		border: 1px solid #e5e7eb;
		border-radius: 8px;
		overflow: hidden;
	}
	.loop-summary__map img {
		display: block;
		width: 100%;
		height: auto;
	}
	.loop-summary__map figcaption {
		font-family: var(--font-inter), system-ui, sans-serif;
		font-size: 12px;
		color: var(--color-muted);
		text-align: center;
		padding: 0.5rem 0.75rem;
		background: var(--color-offwhite);
	}
</style>
