---
// LoopSummary.astro
// Whole-voyage summary: Nebo's own final tally across the entire Great Loop
// (234 boat movements from 22 Apr 2022 to 17 May 2024), plus its full-circle
// route map. Data transcribed from OurLoopMap.jpeg (a Nebo trip-summary
// screenshot the project owner supplied) — this is the authoritative total,
// superseding the older ~5,424nm estimate that was hardcoded elsewhere on
// the site before all logs were in.

const STATS = [
	{ value: '234', label: 'Boat Movements' },
	{ value: '679', label: 'Hours Underway' },
	{ value: '6,273.4', label: 'Nautical Miles' },
	{ value: '9.2', label: 'Average Knots' },
	{ value: '30.0', label: 'Max Knots' },
];
---

<div class="loop-summary">
	<p class="loop-summary__range">22 April 2022 &ndash; 17 May 2024</p>
	<div class="loop-summary__stats">
		{STATS.map((s) => (
			<div class="loop-summary__stat">
				<span class="loop-summary__value">{s.value}</span>
				<span class="loop-summary__label">{s.label}</span>
			</div>
		))}
	</div>
	<figure class="loop-summary__map">
		<img
			class="zoomable-img"
			src="/loop-summary-map.jpg"
			alt="Map of the complete Great Loop route sailed by Jackie B III, a closed circuit from New Bern NC up the East Coast, through the Great Lakes and Canada, down the Mississippi and Tennessee-Tombigbee waterways, around Florida, and back to New Bern"
			loading="lazy"
			decoding="async"
		/>
		<figcaption>The full route &mdash; click to zoom</figcaption>
	</figure>
</div>

<style>
	.loop-summary {
		margin-bottom: 2.5rem;
	}
	.loop-summary__range {
		font-family: var(--font-inter), system-ui, sans-serif;
		font-size: 13px;
		color: var(--color-muted);
		text-align: center;
		margin-bottom: 1rem;
	}
	.loop-summary__stats {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.5rem 2rem;
		margin-bottom: 1.5rem;
	}
	.loop-summary__stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
		min-width: 80px;
	}
	.loop-summary__value {
		font-family: var(--font-inter), system-ui, sans-serif;
		font-size: 26px;
		font-weight: 700;
		color: var(--color-navy);
		line-height: 1.1;
	}
	.loop-summary__label {
		font-family: var(--font-inter), system-ui, sans-serif;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-muted);
		text-align: center;
	}
	.loop-summary__map {
		margin: 0;
		border: 1px solid #e5e7eb;
		border-radius: 8px;
		overflow: hidden;
	}
	.loop-summary__map img {
		display: block;
		width: 100%;
		height: auto;
	}
	.loop-summary__map figcaption {
		font-family: var(--font-inter), system-ui, sans-serif;
		font-size: 12px;
		color: var(--color-muted);
		text-align: center;
		padding: 0.5rem 0.75rem;
		background: var(--color-offwhite);
	}
</style>
