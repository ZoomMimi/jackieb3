---
// VideoFacade.astro
// Click-to-play behavior for the .video-embed placeholders that
// rehype-video-embed.mjs injects into post bodies. Swaps in the real
// iframe only once clicked, so nothing loads a black/blank player up
// front for a video nobody plays.
---

<script>
  const ALLOW =
    'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';

  document.querySelectorAll<HTMLElement>('.video-embed[data-embed-src]').forEach((wrap) => {
    const btn = wrap.querySelector<HTMLButtonElement>('.video-embed__play');
    const src = wrap.dataset.embedSrc;
    if (!btn || !src) return;

    btn.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = src.includes('youtube.com')
          ? `${src}${src.includes('?') ? '&' : '?'}autoplay=1`
          : src;
        iframe.title = 'Video';
        iframe.allow = ALLOW;
        iframe.allowFullscreen = true;
        iframe.loading = 'eager';
        wrap.replaceChildren(iframe);
      },
      { once: true }
    );
  });
</script>
