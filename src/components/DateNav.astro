---
interface DateEntry {
	id: string;
	date: Date;
	title: string;
	draft?: boolean;
}

interface Props {
	dates: DateEntry[];
	currentId: string;
}

const { dates, currentId } = Astro.props;

const byYear = new Map<number, DateEntry[]>();
for (const d of dates) {
	const y = d.date.getUTCFullYear();
	if (!byYear.has(y)) byYear.set(y, []);
	byYear.get(y)!.push(d);
}
const years = [...byYear.keys()].sort((a, b) => a - b);
---

<nav class="date-nav" aria-label="Jump to a date">
	{years.map((y) => (
		<div class="date-nav__year-group">
			<p class="date-nav__year">{y}</p>
			{byYear.get(y)!.map((d) => (
				<a
					href={`/blog/${d.id}/`}
					data-date={d.date.toISOString().slice(0, 10)}
					class:list={['date-nav__link', d.draft && 'date-nav__link--draft']}
					aria-current={d.id === currentId ? 'page' : undefined}
					title={d.title}
				>
					{d.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}
				</a>
			))}
		</div>
	))}
</nav>

<script>
	// Keep the margin where the reader left it when they click through to
	// another date, instead of jumping back to the top on every page load.
	const KEY = 'date-nav-scroll';
	const nav = document.querySelector<HTMLElement>('.date-nav');
	const save = () => {
		if (nav) try { sessionStorage.setItem(KEY, String(nav.scrollTop)); } catch {}
	};
	if (nav) {
		let saved: string | null = null;
		try { saved = sessionStorage.getItem(KEY); } catch {}
		if (saved !== null) {
			nav.scrollTop = Number(saved);
		} else {
			const current = nav.querySelector<HTMLElement>('[aria-current="page"]');
			if (current) nav.scrollTop = current.offsetTop - nav.clientHeight / 2;
		}
		nav.addEventListener('click', save);
		window.addEventListener('pagehide', save);
	}

	// Dev preview only: keep this page in step with the narrative-viewer
	// review tool (scripts/narrative-viewer.mjs on localhost:3002). Picking a
	// date in either one moves the other to the same day.
	if (import.meta.env.DEV && nav) {
		const VIEWER = 'http://localhost:3002';
		const here = nav.querySelector<HTMLElement>('[aria-current="page"]')?.dataset.date;
		// A page opened *because of* a sync jump must not announce itself again,
		// or several open preview tabs end up bouncing dates between each other.
		let followed = false;
		try {
			followed = sessionStorage.getItem('date-nav-sync-jump') === here;
			sessionStorage.removeItem('date-nav-sync-jump');
		} catch {}
		if (here && !followed) {
			fetch(`${VIEWER}/api/sync`, {
				method: 'POST',
				headers: { 'Content-Type': 'text/plain' },
				body: JSON.stringify({ date: here, source: 'preview' }),
			}).catch(() => {});
		}
		const events = new EventSource(`${VIEWER}/api/sync/events`);
		events.onmessage = (e) => {
			const { date, source } = JSON.parse(e.data);
			if (source === 'preview' || !date || date === here) return;
			const link = nav.querySelector<HTMLAnchorElement>(`a[data-date="${date}"]`);
			if (!link) return;
			// Let the next page centre the margin on its own date.
			window.removeEventListener('pagehide', save);
			try {
				sessionStorage.removeItem(KEY);
				sessionStorage.setItem('date-nav-sync-jump', date);
			} catch {}
			window.location.href = link.href;
		};
	}
</script>

<style>
	.date-nav {
		position: sticky;
		top: 80px;
		max-height: calc(100vh - 96px);
		overflow-y: auto;
		width: 100px;
		flex-shrink: 0;
		padding-right: 0.5rem;
	}
	.date-nav__year-group {
		margin-bottom: 0.75rem;
	}
	.date-nav__year {
		font-family: var(--font-inter), system-ui, sans-serif;
		font-size: 11px;
		font-weight: 700;
		color: var(--color-navy);
		margin-bottom: 0.25rem;
	}
	.date-nav__link {
		display: block;
		font-family: var(--font-inter), system-ui, sans-serif;
		font-size: 12px;
		color: var(--color-muted);
		text-decoration: none;
		padding: 0.15rem 0;
		white-space: nowrap;
	}
	.date-nav__link:hover {
		color: var(--color-brass);
		text-decoration: underline;
	}
	/* Drafts only exist in the dev:drafts preview: mark the ones awaiting review. */
	.date-nav__link--draft {
		background: #fef08a;
		color: var(--color-ink, #1f2937);
		border-radius: 3px;
		padding-left: 0.3rem;
		padding-right: 0.3rem;
		margin: 1px 0;
	}
	.date-nav__link[aria-current='page'] {
		color: var(--color-brass);
		font-weight: 700;
	}
	.date-nav::-webkit-scrollbar {
		width: 5px;
	}
	.date-nav::-webkit-scrollbar-thumb {
		background: #d1d5db;
		border-radius: 3px;
	}
</style>
