# Phase 6: New Post Generation — required environment variables.
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed.

# Claude API key, used by scripts/07-quality-lift.mjs and scripts/11-draft-narratives.mjs
ANTHROPIC_API_KEY=

# Cloudflare R2 (S3-compatible object storage) credentials, used by scripts/10-upload-r2.mjs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# R2_PUBLIC_BASE is the bucket's public base URL with no trailing slash
# (the "https://pub-<hash>.r2.dev" form, or a custom domain if configured).
R2_PUBLIC_BASE=
